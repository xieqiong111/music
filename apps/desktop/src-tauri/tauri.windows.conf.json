{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "node ../../scripts/prepare-desktop.mjs"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Playlist Exporter",
      "width": 1200,
      "height": 800,
      "minWidth": 900,
      "minHeight": 600,
      "center": true
    }]
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": { "resources/": "resources/" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"] }
    }
  }
}
