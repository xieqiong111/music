{
  "name": "@playlist-exporter/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@playlist-exporter/contracts": "workspace:*",
    "@playlist-exporter/core": "workspace:*",
    "@playlist-exporter/exporters": "workspace:*",
    "@playlist-exporter/provider-apple": "workspace:*",
    "@playlist-exporter/provider-netease": "workspace:*",
    "@playlist-exporter/provider-qq": "workspace:*",
    "hono": "^4.13.5",
    "music-metadata": "^11.15.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}