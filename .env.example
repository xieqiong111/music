# 跨平台流媒体歌单导出工具 — Docker Compose 环境变量示例
# 复制为 .env 后按需修改；.env 已被 .gitignore / .dockerignore 忽略，绝不提交或进入镜像。
# docker compose 会自动读取工作目录下的 .env。

# 必填：API 访问令牌。
# compose 下容器内 HOST=0.0.0.0（容器隔离即边界，宿主机回环由端口映射保证），
# 按服务端安全不变量，非 loopback 监听必须配置 ACCESS_TOKEN，缺失时拒绝启动。
# 生成强随机令牌（Node 24，≥32 字节）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 调用 API 时携带：Authorization: Bearer <ACCESS_TOKEN>
ACCESS_TOKEN=

# 宿主机端口（容器内固定监听 4319，右侧容器端口请勿修改）。
PORT=4319

# 宿主机数据目录，映射到容器内 /data（只读根文件系统下唯一持久化目录之一）。
DATA_DIR=./data
